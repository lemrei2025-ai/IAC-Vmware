# Archivo de variables para crear-vm.cmd  (uso:  crear-vm.cmd --vars ejemplos\ubuntu-server.vars)
# Formato CLAVE=VALOR, sin espacios alrededor del "=". Las lineas con # son comentarios.
# Los parametros escritos DESPUES de --vars en la linea de comandos tienen prioridad.
#
# Claves permitidas: VM_NAME DIR ISO OS CPUS MEM_MB DISK_GB NET NIC FIRMWARE HWVER
VM_NAME=ubuntu-server
ISO=C:\ISOs\ubuntu-24.04-live-server-amd64.iso
OS=ubuntu-64
CPUS=2
MEM_MB=4096
DISK_GB=40
NET=nat
NIC=e1000e
FIRMWARE=bios
